    "vue-pdf-embed": "^2.1.4",
    "vue-router": "^4.5.1",
    "vue3-pdfjs": "^0.0.1",
    "vuetify": "^3.10.3"
  },
  "devDependencies": {
    "@prettier/plugin-oxc": "^0.0.4",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.16.5",
